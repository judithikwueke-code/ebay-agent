{
  "manifest_version": 3,
  "name": "Terapeak Research Collector",
  "version": "1.6",
  "description": "Sends Terapeak sold-price data and the eBay product pages you open to your eBay agent.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.ebay.co.uk/sh/research*",
    "https://www.ebay.co.uk/itm/*",
    "http://204.168.194.157:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ebay.co.uk/sh/research*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.ebay.co.uk/itm/*"],
      "js": ["item.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Terapeak Collector"
  }
}
